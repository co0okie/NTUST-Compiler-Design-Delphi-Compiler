(* fib.delphi
 *
 * This test program computes and prints the first N Fibonacci numbers
 *)

program fib;

    // constant
    const N = 40;

    // variables
    var i, Fn, FNminus1, temp: integer;

begin
    // variable initialization
    Fn := 1;
    FNminus1 := 0;

    write "Printing the first ";
    write N;
    writeln " Fibonacci numbers:";
    writeln "-----------------------------------";

    // compute and print continuously
    for i := 1 to N do
    begin
        // Print current Fibonacci number
        write "Fib("; 
        write i; 
        write ") = ";
        writeln Fn;

        // Calculate the next Fibonacci number
        temp := Fn;
        Fn := Fn + FNminus1;
        FNminus1 := temp;
    end;
    
    writeln "-----------------------------------";
    writeln "Computation finished.";
end fib.