program tricky;

(* =======================================================
 * Global Declarations & Compile-Time Evaluation
 * ======================================================= *)
const STR_START = "--- Starting Extreme Syntax & JVM Tests ---";
const STR_END = "--- All Tests Executed ---";
const EXPECTED_MATH = -4;
const FLAG_CONST = not false and true; // Boolean expression in const

// id_list test
var g_result, g_counter: integer; 
// opt_init test in global
var g_flag: boolean = true;       

(* =======================================================
 * Test 1: Parameterless Procedure & Empty Return
 * ======================================================= *)
procedure EmptyProc;
begin
    write "Test 1 [EmptyProc]: ";
    writeln "Executed!";
    return; // Explicit empty return (TYPE_VOID)
end EmptyProc;

(* =======================================================
 * Test 2: Complex Arithmetic (+, -, *, /, mod, unary -)
 * ======================================================= *)
function ComplexMath(a: integer, b: integer): integer;
// opt_init test in local scope
var local_var: integer = 10;
begin
    // Testing Precedence, Unary Minus, and Modulo
    // Expected: a=10, b=5 -> -5 + (10 * 5) / 2 mod 4 = -5 + 25 mod 4 = -5 + 1 = -4
    return -5 + (a * b) / 2 mod 4;
end ComplexMath;

(* =======================================================
 * Test 3: Deep Recursion (JVM Stack Integrity)
 * ======================================================= *)
function Factorial(n: integer): integer;
begin
    if n <= 1 then
        return 1;
    else
        return n * Factorial(n - 1);
end Factorial;

(* =======================================================
 * Test 4: Relational & Logical Operators (<, <=, >, >=, =, <>, and, or, not)
 * ======================================================= *)
function TestLogic(val: integer): boolean;
var b1, b2: boolean;
begin
    // Expected: val=15 -> b1 = (true and false or false) = false
    // b2 = (true or true and true) = true
    b1 := (val <> 0) and (val < 10) or not (val >= 5);
    b2 := (val = 15) or (val <= 20) and (val > 0);
    
    if b1 or b2 then
        return true;
    else
        return false;
end TestLogic;

(* =======================================================
 * Test 5: All Loops (For, While, Repeat) & Dangling-Else
 * ======================================================= *)
procedure TestControlFlow(limit: integer);
var i: integer;
var sum: integer = 0;
begin
    // FOR Loop Test
    for i := 1 to limit do
    begin
        sum := sum + i;
    end; // sum = 1+2+3+4+5 = 15

    // WHILE Loop Test
    while sum > 10 do
        sum := sum - 1; // sum stops at 10

    // REPEAT-UNTIL Loop Test
    repeat
        sum := sum * 2; // 10*2 = 20
    until sum >= 20;

    // Nested IF-THEN-ELSE (Dangling Else Trap)
    // Note: Semicolons are required before 'else' according to our yacc grammar!
    if sum >= 20 then
        if sum = 999 then
            writeln "Test 5 [Control Flow]: Failed (Dangling Else Trap)";
        else
            writeln "Test 5 [Control Flow]: Success";
    else
        writeln "Test 5 [Control Flow]: Failed";
end TestControlFlow;

(* =======================================================
 * Test 6: Insane Scope Shadowing & Block Statements
 * ======================================================= *)
procedure TestShadowing;
var x: integer = 1;
begin
    // Anonymous block testing
    begin 
        // local index should correctly assign and hide outer 'x'
        var x: integer = 2; 
        if x = 2 then
            writeln "Test 6 [Shadowing L2]: Success";
        else
            writeln "Test 6 [Shadowing L2]: Failed";
    end;
    
    // Original 'x' should be restored
    if x = 1 then
        writeln "Test 6 [Shadowing L1]: Success";
    else
        writeln "Test 6 [Shadowing L1]: Failed";
end TestShadowing;

(* =======================================================
 * Test 7: Direct Print Types (Int, Bool, Expr)
 * ======================================================= *)
procedure TestPrintTypes;
var print_int: integer = 999;
var print_bool: boolean = false;
begin
    write "Test 7 [Print Int Constant]: ";
    writeln 777;
    
    write "Test 7 [Print Int Variable]: ";
    writeln print_int;
    
    write "Test 7 [Print Bool Constant]: ";
    writeln true;
    
    write "Test 7 [Print Bool Variable]: ";
    writeln print_bool;

    write "Test 7 [Print Complex Expr]: ";
    writeln (print_int mod 100) > 50; // Should print true (99 > 50)
end TestPrintTypes;


(* =======================================================
 * MAIN EXECUTION BLOCK
 * ======================================================= *)
begin
    writeln STR_START;

    // Test parameterless invocation (both with and without parentheses)
    EmptyProc();
    EmptyProc;

    // Arithmetic Test
    g_result := ComplexMath(10, 5);
    if g_result = EXPECTED_MATH then
        writeln "Test 2 [Math]: Success";
    else
        writeln "Test 2 [Math]: Failed";

    // Recursion Test
    g_result := Factorial(5);
    if g_result = 120 then
        writeln "Test 3 [Recursion]: Success";
    else
        writeln "Test 3 [Recursion]: Failed";

    // Logic Test
    g_flag := TestLogic(15);
    if g_flag = true then
        writeln "Test 4 [Logic]: Success";
    else
        writeln "Test 4 [Logic]: Failed";

    // Loops & Control Flow Test
    TestControlFlow(5); 

    // Scope Shadowing Test
    TestShadowing;
    
    // Direct output testing
    TestPrintTypes;

    writeln STR_END;
end tricky.