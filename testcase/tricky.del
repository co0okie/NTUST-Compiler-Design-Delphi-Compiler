program UltimateTrickyTest;

(* =======================================================
 * 1. 全域宣告與極端常數摺疊 (Compile-Time Evaluation)
 * ======================================================= *)
const PI = 3.1415926;
const BASE_OFFSET = -10 + (5 * 4) / 2 mod 3; // 測試括號優先級、負號與 Mod
const MAGIC_NUM = BASE_OFFSET + 42;
const IS_READY = not (BASE_OFFSET = 0) and (MAGIC_NUM >= 40) or false;
const STR_CONST = "Welcome to the ""Ultimate"" Compiler Test!";

var g_int1, g_int2: integer; 
var g_real: real;
var g_flag: boolean;
// 測試變數宣告時的 opt_init (雖然目前 Parser 不轉成賦值指令，但語法必須過)
var initializedVar: integer = 999; 

var g_intArray: array [0, 100] of integer;
var g_realArray: array [1, 50] of real;


(* =======================================================
 * 2. 遞迴函數與隱式型別轉換 (Implicit Conversions)
 * ======================================================= *)
function MathMagic(a: real, b: integer, c: boolean): real;
const LOCAL_MULTIPLIER = 2.5;
var result: real;
begin
    if c = true then
        // a (real) + b (int) * const (real) => 引發 Warning 但必須推導為 Real
        result := a + b * LOCAL_MULTIPLIER;
    else
    begin
        const INNER_CONST = 10;
        result := b mod INNER_CONST; // int 轉 real 的 Warning
    end;
    
    return result;
end MathMagic;

function Factorial(n: integer): integer;
begin
    if n <= 1 then 
        return 1;
    else 
        return n * Factorial(n - 1); // 遞迴呼叫
end Factorial;


(* =======================================================
 * 3. 巢狀迴圈、Dangling-Else 與陣列極限操作
 * ======================================================= *)
procedure DeepNesting(limit: integer);
var i, j: integer;
var temp: real;
begin
    for i := 1 to limit do
    begin
        j := limit;
        while j > 0 do
        begin
            repeat
                // 陣列索引包含複雜四則運算與 Function 呼叫
                g_intArray[(i * j) mod 100 + Factorial(3)] := i + j;
                
                // 終極 Dangling-Else 測試
                if i > 5 then
                    if j < 2 then
                        writeln "Critical Depth Reached";
                    else
                        writeln "Going Deeper";
                else
                    temp := MathMagic(3.14, j, IS_READY); // Function 做為 Rvalue
                
                j := j - 1;
            until j <= 0;
        end;
    end;
end DeepNesting;

procedure ParamlessProc;
var shadowFlag: string;
begin
    shadowFlag := "This procedure takes no arguments!";
    writeln shadowFlag;
end ParamlessProc;


(* =======================================================
 * 4. 主程式執行區塊與變數遮蔽 (Scope Shadowing)
 * ======================================================= *)
begin
    writeln STR_CONST;
    
    g_int1 := 5;
    g_int2 := 10;
    
    // 陣列賦值伴隨隱式型別轉換 (Int to Real Array)
    g_realArray[1] := Factorial(g_int1);
    
    (* 測試 4.1：無參數 Subprogram 呼叫的兩種合法型態 *)
    ParamlessProc;     // 沒括號
    ParamlessProc();   // 有括號 (opt_invoke 空參數)
    
    (* 測試 4.2：瘋狂的 Block 變數遮蔽 (Shadowing) *)
    begin
        // 遮蔽全域 g_int1 (變成常數)
        const g_int1 = 777; 
        // 遮蔽全域 g_int2 (變成浮點數)
        var g_int2: real;   
        
        g_int2 := 99.9;
        g_real := g_int1 + g_int2; // Const int + Var real
        
        writeln "Entering deepest scope...";
        begin
            // 再次遮蔽 g_int1，這次變成字串！
            var g_int1: string; 
            g_int1 := "I am a shadowed string now!";
            writeln g_int1;
        end;
        // 離開內層，字串 g_int1 消滅。現在印出的是浮點數 g_int2
        writeln g_int2;
    end;
    // 離開外層，所有遮蔽解除。現在 g_int1 變回整數 5
    
    (* 測試 4.3：複雜布林邏輯與 Procedure 呼叫 *)
    if (g_int1 = 5) and (not IS_READY) or (g_realArray[1] >= 0.0) then
        DeepNesting(3); // Procedure 呼叫作為陳述句
    else
        writeln "Conditions not met.";
        
    read g_flag;
end UltimateTrickyTest.