program tricky;

(* =======================================================
 * Constant Folding & Global Initialization
 * ======================================================= *)
const EXPECTED_MATH = -2;
const STR_START = "--- Starting Extreme JVM Tests ---";
const STR_END = "--- All Tests Executed ---";

var g_result: integer;
var g_flag: boolean;

(* =======================================================
 * Test 1: Deep Recursion (JVM Stack Frame Integrity)
 * ======================================================= *)
function Factorial(n: integer): integer;
begin
    if n <= 1 then
        return 1;
    else
        return n * Factorial(n - 1);
end Factorial;

(* =======================================================
 * Test 2: Complex Arithmetic & Strict Boolean Logic
 * ======================================================= *)
function TestMathAndLogic(val: integer, flag: boolean): boolean;
var math_res: integer;
var logic_res: boolean;
begin
    // Testing Precedence, Unary Minus, and Modulo
    // Expected: val = 10 -> 10 * 3 = 30 -> 30 / 2 = 15 -> 15 mod 4 = 3 -> -5 + 3 = -2
    math_res := -5 + (val * 3) / 2 mod 4;

    if math_res = EXPECTED_MATH then
        writeln "Test 1 [Arithmetic Precedence]: Success";
    else
        writeln "Test 1 [Arithmetic Precedence]: Failed";

    // Testing strict boolean evaluation and short-circuiting logic
    // Expected: (-2 < 0) and true or not (10 = 10) -> true and true or false -> true
    logic_res := (math_res < 0) and flag or not (val = 10);
    
    if logic_res then
        writeln "Test 2 [Boolean Logic]: Success";
    else
        writeln "Test 2 [Boolean Logic]: Failed";

    return logic_res;
end TestMathAndLogic;

(* =======================================================
 * Test 3: Insane Scope Shadowing
 * ======================================================= *)
procedure TestShadowing;
var target: integer;
begin
    target := 100; // Level 1
    begin
        var target: integer; 
        target := 200; // Level 2 (Shadows Level 1)
        begin
            var target: integer;
            target := 300; // Level 3 (Shadows Level 2)
            
            if target = 300 then 
                writeln "Test 3 [Deep Shadowing L3]: Success"; 
            else 
                writeln "Test 3 [Deep Shadowing L3]: Failed";
        end;
        
        // Exited Level 3, target should be 200 again
        if target = 200 then 
            writeln "Test 4 [Scope Restoration L2]: Success"; 
        else 
            writeln "Test 4 [Scope Restoration L2]: Failed";
    end;
    
    // Exited Level 2, target should be 100 again
    if target = 100 then 
        writeln "Test 5 [Scope Restoration L1]: Success"; 
    else 
        writeln "Test 5 [Scope Restoration L1]: Failed";
end TestShadowing;

(* =======================================================
 * Test 4: Nested Loops & The Dangling-Else Trap
 * ======================================================= *)
procedure TestLoopsAndControlFlow(limit: integer);
var i: integer;
var sum: integer;
begin
    sum := 0;
    
    // 4.1 For Loop & Dangling Else Check
    for i := 1 to limit do
    begin
        // if limit = 3, sum += 1 + 2 + 3 = 6
        sum := sum + i;
        
        // The ultimate Dangling-Else test
        if sum > 0 then
            if sum = 999 then
                writeln "Dangling Else Trap: Failed (Should not hit)";
            else
                sum := sum; // Dummy operation, binds to inner IF
        // No else for the outer IF
    end;

    if sum = 6 then 
        writeln "Test 6 [For Loop & Dangling Else]: Success"; 
    else 
        writeln "Test 6 [For Loop & Dangling Else]: Failed";

    // 4.2 While Loop Check
    sum := 0;
    i := 0;
    while i < 3 do
    begin
        i := i + 1;
        sum := sum + i;
    end;
    
    if sum = 6 then 
        writeln "Test 7 [While Loop]: Success"; 
    else 
        writeln "Test 7 [While Loop]: Failed";

    // 4.3 Repeat-Until Loop Check
    sum := 0;
    i := 0;
    repeat
        i := i + 1;
        sum := sum + i;
    until i >= 3;
    
    if sum = 6 then 
        writeln "Test 8 [Repeat-Until Loop]: Success"; 
    else 
        writeln "Test 8 [Repeat-Until Loop]: Failed";

end TestLoopsAndControlFlow;

(* =======================================================
 * MAIN EXECUTION BLOCK
 * ======================================================= *)
begin
    writeln STR_START;

    g_flag := TestMathAndLogic(10, true);

    TestShadowing;

    g_result := Factorial(5);
    if g_result = 120 then
        writeln "Test 9 [Recursive Function]: Success";
    else
        writeln "Test 9 [Recursive Function]: Failed";

    TestLoopsAndControlFlow(3);

    writeln STR_END;
end tricky.