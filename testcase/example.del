(*
 * Example with Functions
 *)

program Example;

// constants
const a = 5;

// variables
var c: integer;

// function declaration
function add(a:integer, b:integer): integer;
begin
  return a+b;
end add;

// main function
begin
  c := add(a, 10);
  if (c > 10) then
    write -c;
  else
    write c;
  writeln "Hello World";
end Example.